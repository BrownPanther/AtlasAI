NODE_ENV=development
PORT=4000

# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

DB_PATH=./data/atlasai.db

# Optional: only used if you have a local Ollama instance running.
# AtlasAI works fully without these — RuleBasedProvider is the default.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Real travel-data providers (all optional) ---
# AtlasAI works fully without any of these — sample/demo data is used for
# whichever categories are left unconfigured. See SETUP.md for what each
# key unlocks, free-tier limits, and how to get one.

# Attractions/places (R2, integrated) — free OpenTripMap key from https://dev.opentripmap.com
# Backend-only: never prefix with VITE_ and never commit a real value.
ATTRACTIONS_API_KEY=

# Maps/routing — free key from https://openrouteservice.org/dev/#/signup
MAPS_API_KEY=

# Flights (Duffel Flights API - live/test offer requests) — https://duffel.com
DUFFEL_API_KEY=

# Flights + hotels — test-environment credentials from
# https://developers.amadeus.com (returns synthetic data, not live pricing/availability)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Weather — free key from https://openweathermap.org/api
WEATHER_API_KEY=

# Trains — RailRadar (R6, integrated). Free sandbox key (1,000 req/month)
# from https://railradar.in. See backend/src/providers/railProvider.js.
TRAINS_API_KEY=
